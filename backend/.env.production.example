# =========================================================
# Genel
# =========================================================
PORT=8186
NODE_ENV=production

# =========================================================
# DB bağlantısı
# =========================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=kompozit_runtime
DB_PASSWORD=
DB_NAME=kompozit

SITE_SETTINGS_KEY_PREFIX=kompozit__

# =========================================================
# Auth / login
# =========================================================
ALLOW_TEMP_LOGIN=0
TEMP_PASSWORD=

JWT_SECRET=
COOKIE_SECRET=

# Admin allowlist (signup / google login ile admin olacak mailler)
AUTH_ADMIN_EMAILS=orhanguzell@gmail.com

# Seed için kullanılacak admin hesap
SEED_ADMIN_EMAIL=orhanguzell@gmail.com
SEED_ADMIN_PASSWORD=

# =========================================================
# CORS
# =========================================================
CORS_ORIGIN=https://karbonkompozit.com.tr,https://www.karbonkompozit.com.tr,https://panel.karbonkompozit.com.tr

# =========================================================
# Storage / Upload
# =========================================================

# Varsayılan driver: cloudinary | local
STORAGE_DRIVER=local

# Local driver kullanırsan (şimdilik placeholder)
LOCAL_STORAGE_ROOT=/uploads
LOCAL_STORAGE_BASE_URL=/uploads
CLOUDINARY_DEFAULT_FOLDER=uploads

# CDN / public API base (slider repo + storage servisi buradan üretiyor)
STORAGE_CDN_PUBLIC_BASE=
STORAGE_PUBLIC_API_BASE=https://www.karbonkompozit.com.tr/api

# Cloudinary
CLOUDINARY_CLOUD_NAME=dbozv7wqd
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=kompozit
# Kod CLOUDINARY_UNSIGNED_PRESET bekliyor
CLOUDINARY_UNSIGNED_PRESET=unsigned_preset
CLOUDINARY_UNSIGNED_UPLOAD_PRESET =unsigned_preset

# =========================================================
# Mail / SMTP
# =========================================================
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@karbonkompozit.com.tr
SMTP_SECURE=true

# =========================================================
# URL’ler
# =========================================================
# Backend URL (Fastify)
PUBLIC_URL=https://www.karbonkompozit.com.tr/api

# FE'nin base URL'i
FRONTEND_URL=https://www.karbonkompozit.com.tr

# Bazı yerler PUBLIC_API_BASE de kullanıyor olabilir; uyumlu olsun
PUBLIC_API_BASE=https://www.karbonkompozit.com.tr/api

# =========================================================
# Google OAuth (ID token + redirect flow)
# =========================================================
GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

PUPPETEER_EXECUTABLE_PATH=/root/.cache/puppeteer/chrome/linux-147.0.7727.57/chrome-linux64/chrome

# =========================================================
# Audit / IP Blocklist — sunucu kendi IP'si asla loglanmaz/bloklanmaz
# =========================================================
AUDIT_EXCLUDE_IPS=127.0.0.1,::1,::ffff:127.0.0.1

# Public registration must never grant an administrative role.
AUTH_PUBLIC_SIGNUP_ROLE=user
